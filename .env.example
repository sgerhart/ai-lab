# Copy to a gitignored .env on the host that will run services.
# Never commit the filled file. Empty values mean "not configured".

# --- Bind address for published container ports ---
# Default is loopback. For tailnet access from other hosts, set this to the
# machine's Tailscale IPv4 (placeholder until supplied). Never use 0.0.0.0
# without a documented firewall exception.
AI_LAB_BIND_ADDRESS=127.0.0.1

# --- PostgreSQL (M1 control plane) ---
POSTGRES_USER=ai_lab
POSTGRES_PASSWORD=
POSTGRES_DB=ai_lab
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Qdrant ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Agent API (M1; not deployed) ---
AI_LAB_API_PORT=8088
# AI_LAB_API_TOKEN=
# DATABASE_URL=postgresql://ai_lab:CHANGE_ME@127.0.0.1:5432/ai_lab
# STUDIO_WORKER_URL=http://127.0.0.1:8090
# AI_LAB_WORKSPACE=
# AI_LAB_ARTIFACT_ROOT=
# OLLAMA_HOST=http://{{STUDIO_TAILSCALE_MAGICDNS}}:11434

# --- Optional cloud fallbacks (leave unset to force local-only) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Backup destination (not the M1 itself) ---
# AI_LAB_BACKUP_TARGET=  # e.g. {{BACKUP_HOST}}:{{BACKUP_PATH}}
